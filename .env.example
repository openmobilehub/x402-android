# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — it must never be committed.

# Your test wallet on Base Sepolia. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then fund the corresponding address from https://faucet.circle.com (USDC)
# and https://www.alchemy.com/faucets/base-sepolia (a tiny bit of ETH).
PRIVATE_KEY=

# Coinbase Developer Platform API credentials (free tier).
# Sign up at https://portal.cdp.coinbase.com
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=

# RPC endpoint. Default works fine for testnet, but you'll hit rate limits.
# For real use, get a free Alchemy or QuickNode endpoint.
BASE_SEPOLIA_RPC=https://sepolia.base.org

# The merchant address USDC is paid TO. For step 1 this is whatever the
# demo endpoint specifies in its 402 response — leave blank.
MERCHANT_ADDRESS=
